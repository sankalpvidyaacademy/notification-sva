generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  password  String
  role      String   // ADMIN, TEACHER, STUDENT
  classes   String   @default("[]") // JSON array of class names. Student: single-element array
  subjects  String   @default("{}") // JSON: Teacher = { "Class 9 CBSE": ["Mathematics", "Physics"], ... }; Student = ["Mathematics", "Physics"] (flat array for their single class)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id            String   @id @default(cuid())
  senderId      String
  senderName    String
  recipientType String   // ADMIN, TEACHER, STUDENT
  targetData    String   @default("{}") // JSON: For STUDENT type = { "Class 9 CBSE": ["Mathematics", "Physics"], "Class 11 Science": ["Biology"] }
  topic         String
  message       String
  date          String   // Notification date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
