// ─────────────────────────────────────────────────────────
// FIRESTORE SECURITY RULES — PHASE 2 (PRODUCTION SECURITY)
// ─────────────────────────────────────────────────────────
//
// 🚨 APPLY ONLY AFTER FULL TESTING IS COMPLETE
// 🚨 This enforces role-based access control
// 🚨 Applying too early may break the app
//
// ✅ Apply this when:
//    1. All features are tested and working with Phase 1 rules
//    2. Firebase Authentication is integrated
//    3. Custom claims (role, userId) are set on auth tokens
//    4. You're ready for production deployment
//
// ⚠️ PREREQUISITE:
//    - Users must have custom claims set:
//      { role: "ADMIN" | "TEACHER" | "STUDENT", userId: "shobhit" }
//    - Set claims via Firebase Admin SDK:
//      admin.auth().setCustomUserClaims(uid, { role: "ADMIN", userId: "shobhit" })
// ─────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USERS COLLECTION ───

    match /users/{userId} {
      // Any authenticated user can read user profiles
      allow read: if request.auth != null;

      // Any authenticated user can create (registration)
      allow create: if request.auth != null;

      // Only the user themselves can update/delete their profile
      // Admin override is handled via Admin SDK (server-side, bypasses rules)
      allow update, delete: if request.auth != null
        && request.auth.token.userId == userId;
    }

    // ─── NOTIFICATIONS COLLECTION ───

    match /notifications/{notificationId} {
      // Any authenticated user can read notifications
      // (Filtering by role/class/subject is done in the API layer)
      allow read: if request.auth != null;

      // Only ADMIN & TEACHER can create notifications
      allow create: if request.auth != null
        && request.auth.token.role in ['ADMIN', 'TEACHER'];

      // Only ADMIN can delete notifications
      allow delete: if request.auth != null
        && request.auth.token.role == 'ADMIN';

      // No updates allowed (notifications are immutable)
      allow update: if false;
    }

    // ─── MESSAGES COLLECTION ───

    match /messages/{messageId} {
      // Sender or Receiver can read their messages
      // Admin sees all (handled via Admin SDK on server side)
      allow read: if request.auth != null
        && (
          request.auth.token.userId == resource.data.senderId
          || request.auth.token.userId == resource.data.receiverId
          || request.auth.token.role == 'ADMIN'
        );

      // Any authenticated user can send a message
      allow create: if request.auth != null
        && request.auth.token.userId == request.resource.data.senderId;

      // Only sender can update/delete their own messages
      allow update, delete: if request.auth != null
        && request.auth.token.userId == resource.data.senderId;
    }

    // ─── DEFAULT DENY ───
    // Deny access to any collection not explicitly listed above

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
