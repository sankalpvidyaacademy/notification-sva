// ─────────────────────────────────────────────────────────
// FIRESTORE SECURITY RULES — Default (Phase 1: Development)
// ─────────────────────────────────────────────────────────
//
// This is the file used by `firebase deploy --only firestore:rules`
// It currently points to Phase 1 (open) rules for development.
//
// ⚠️ Switch to Phase 2 rules when ready for production:
//    1. Copy contents from firestore-rules/firestore.rules.phase2
//    2. Replace this file's contents
//    3. Run: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Phase 1: Allow all authenticated users to read/write
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
