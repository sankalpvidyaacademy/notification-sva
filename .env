# ─────────────────────────────────────────────────────────
# DATABASE (Prisma/SQLite) — Used when USE_FIREBASE=false
# ─────────────────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─────────────────────────────────────────────────────────
# BACKEND SWITCH
# ─────────────────────────────────────────────────────────
# Set to "true" to use Firebase/Firestore instead of Prisma/SQLite
USE_FIREBASE=false

# ─────────────────────────────────────────────────────────
# FIREBASE — Client SDK (NEXT_PUBLIC_ prefix = accessible in browser)
# Used by: firebase/firebaseConfig.ts
# Also add these in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxx
NEXT_PUBLIC_FIREBASE_APP_ID=xxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=xxxx

# ─────────────────────────────────────────────────────────
# FIREBASE — Admin SDK (Server-side only, NOT exposed to browser)
# Used by: firebase/firebaseInit.ts → firebase-admin
# ⚠️ DO NOT prefix with NEXT_PUBLIC_ (would expose secrets to client)
# ⚠️ FIREBASE_PRIVATE_KEY: paste the full key including -----BEGIN...-----END-----
# ─────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
